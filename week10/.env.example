# Google AI Studio API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key

# Optional tracing. If disabled, the app still runs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=secure-rag-gemini-lab
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

GEMINI_MODEL=gemini-2.5-flash

# Set these from the current official pricing page for your selected model.
# USD per 1 million tokens. Leave at 0 until you configure current prices.
GEMINI_INPUT_USD_PER_1M=0
GEMINI_OUTPUT_USD_PER_1M=0
